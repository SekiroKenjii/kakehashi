{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Client (WinUI)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-client",
      "program": "${workspaceFolder}/client/src/App/__APP_NAME__.App/bin/x64/Debug/net10.0-windows10.0.19041.0/__APP_NAME__.App.exe",
      "args": [],
      "cwd": "${workspaceFolder}/client/src/App/__APP_NAME__.App",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      "name": "Server (Go)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/server/cmd/server",
      "env": {
        "__APP_NAME_UPPER___SQLSERVER_DSN": "sqlserver://sa:__APP_NAME__!Dev1@localhost:1433?database=__APP_NAME_LOWER__&encrypt=disable",
        "__APP_NAME_UPPER___MONGO_URI": "mongodb://localhost:27017",
        "__APP_NAME_UPPER___LOG_FORMAT": "text",
        "__APP_NAME_UPPER___LOG_LEVEL": "debug"
      }
    }
  ]
}
