/// by the UI layer at composition time.
/// </summary>
/// <remarks>
/// Every method returns a <see cref="Result"/> rather than throwing. A backend that is down is
/// an expected state for a desktop app, not an exceptional one: the user closed their laptop, or
/// the VPN dropped. It belongs in the return type, where a view model has to deal with it.
/// <para>
/// The write methods take a <see cref="{{.Entity}}Draft"/>, so nothing that has not been validated can
/// reach the wire. The type is the check.
/// </para>
/// </remarks>
public interface I{{.Module}}Gateway
{
    /// <summary>Lists every {{.Variable}}, most recently updated first.</summary>
    Task<Result<IReadOnlyList<{{.Entity}}Dto>>> ListAsync(CancellationToken cancellationToken);

    /// <summary>Creates {{article .Variable}} {{.Variable}} and returns it as stored, with its server-assigned id.</summary>
    Task<Result<{{.Entity}}Dto>> CreateAsync({{.Entity}}Draft draft, CancellationToken cancellationToken);

    /// <summary>Rewrites {{article .Variable}} {{.Variable}}'s title and body.</summary>
    Task<Result<{{.Entity}}Dto>> UpdateAsync(
        long id, {{.Entity}}Draft draft, CancellationToken cancellationToken);

    /// <summary>Removes {{article .Variable}} {{.Variable}}. Removing one that is already gone succeeds.</summary>
    Task<Result> DeleteAsync(long id, CancellationToken cancellationToken);
}
