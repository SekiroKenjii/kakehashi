<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>{{.RootNamespace}}.Modules.{{.Module}}.UI</RootNamespace>
    <AssemblyName>{{.AppName}}.Modules.{{.Module}}.UI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <!-- See {{.AppName}}.Modules.Auth.UI for why CS0618 is here: the XAML type generator emits a
         reference to a property the Windows App SDK deprecated, in a file nobody writes. -->
    <NoWarn>CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\App\{{.AppName}}.App.Infrastructure\{{.AppName}}.App.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Shared\{{.AppName}}.Contracts\{{.AppName}}.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Shared\{{.AppName}}.UI.Common\{{.AppName}}.UI.Common.csproj" />
    <ProjectReference Include="..\..\..\Shared\{{.AppName}}.UI.Contracts\{{.AppName}}.UI.Contracts.csproj" />
    <ProjectReference Include="..\{{.AppName}}.Modules.{{.Module}}.Application\{{.AppName}}.Modules.{{.Module}}.Application.csproj" />
  </ItemGroup>

</Project>
