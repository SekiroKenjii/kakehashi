using System.Linq;
using {{.RootNamespace}}.Modules.{{.Module}}.Domain.{{.Module}};
using Xunit;

namespace {{.RootNamespace}}.Modules.{{.Module}}.Domain.Tests;

/// <summary>
/// The client's copy of the server's {{.Variable}} rules. They are duplicated on purpose — this one is
/// for immediate feedback, the server's is the one that decides — so these tests exist to keep
/// the copy faithful.
/// </summary>
public sealed class {{.Entity}}DraftTests
{
    [Fact]
    public void Create_TrimsTheTitle()
    {
        var result = {{.Entity}}Draft.Create("  Shopping list  ", "milk");

        Assert.True(result.IsSuccess);
        Assert.Equal("Shopping list", result.Value.Title);
        Assert.Equal("milk", result.Value.Body);
    }

    [Theory]
    [InlineData(null)]
    [InlineData("")]
    [InlineData("   ")]
    [InlineData("\t\n")]
    public void Create_RejectsATitleThatIsOnlySpace(string? title)
    {
        var result = {{.Entity}}Draft.Create(title, "body");

        Assert.True(result.IsFailure);
        Assert.Equal({{.Module}}Errors.TitleRequired, result.Error);
    }

    [Fact]
    public void Create_TreatsANullBodyAsEmpty()
    {
        // {{articleUpper .Variable}} {{.Variable}} is a title with optional contents. Requiring a body would make "call the bank"
        // impossible to write.
        var result = {{.Entity}}Draft.Create("Title", body: null);

        Assert.True(result.IsSuccess);
        Assert.Equal(string.Empty, result.Value.Body);
    }

    [Fact]
    public void Create_AcceptsATitleAtExactlyTheLimit()
    {
        var result = {{.Entity}}Draft.Create(new string('a', {{.Entity}}Draft.MaxTitleLength), string.Empty);

        Assert.True(result.IsSuccess);
    }

    [Fact]
    public void Create_RejectsATitleOverTheLimit()
    {
        var result = {{.Entity}}Draft.Create(new string('a', {{.Entity}}Draft.MaxTitleLength + 1), string.Empty);

        Assert.True(result.IsFailure);
        Assert.Equal({{.Module}}Errors.TitleTooLong, result.Error);
    }

    [Fact]
    public void Create_CountsTextElementsNotCharacters()
    {
        // "e" plus U+0301 COMBINING ACUTE ACCENT: one letter on screen, two UTF-16 chars in memory,
        // so counting chars would reject 120 of them where the server accepts them.
        const string composed = "é";
        var title = string.Concat(Enumerable.Repeat(composed, {{.Entity}}Draft.MaxTitleLength));

        // The premise of the test. If this ever stops holding, the assertion below proves nothing.
        Assert.Equal({{.Entity}}Draft.MaxTitleLength * 2, title.Length);

        var result = {{.Entity}}Draft.Create(title, string.Empty);

        Assert.True(result.IsSuccess);
    }
}
