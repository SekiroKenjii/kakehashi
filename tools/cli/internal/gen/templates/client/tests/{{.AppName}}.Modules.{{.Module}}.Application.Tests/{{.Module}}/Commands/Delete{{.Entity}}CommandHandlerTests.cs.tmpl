using System.Threading;
using System.Threading.Tasks;
using {{.RootNamespace}}.Modules.{{.Module}}.Application.Abstractions;
using {{.RootNamespace}}.Modules.{{.Module}}.Application.{{.Module}}.Commands.Delete{{.Entity}};
using {{.RootNamespace}}.Modules.{{.Module}}.Domain.{{.Module}};
using {{.RootNamespace}}.SharedKernel;
using NSubstitute;
using Xunit;

namespace {{.RootNamespace}}.Modules.{{.Module}}.Application.Tests.{{.Module}}.Commands;

public sealed class Delete{{.Entity}}CommandHandlerTests
{
    private readonly I{{.Module}}Gateway _{{.ID}} = Substitute.For<I{{.Module}}Gateway>();

    private Delete{{.Entity}}CommandHandler CreateHandler()
    {
        return new Delete{{.Entity}}CommandHandler(_{{.ID}});
    }

    [Fact]
    public async Task Handle_ForwardsTheIdToTheGateway()
    {
        _{{.ID}}.DeleteAsync(Arg.Any<long>(), Arg.Any<CancellationToken>())
            .Returns(Result.Success());

        var result = await CreateHandler().Handle(new Delete{{.Entity}}Command(42), CancellationToken.None);

        Assert.True(result.IsSuccess);
        await _{{.ID}}.Received(1).DeleteAsync(42, Arg.Any<CancellationToken>());
    }

    [Fact]
    public async Task Handle_GatewayFailure_SurfacesTheError()
    {
        _{{.ID}}.DeleteAsync(Arg.Any<long>(), Arg.Any<CancellationToken>())
            .Returns(Result.Failure({{.Module}}Errors.RequestFailed));

        var result = await CreateHandler().Handle(new Delete{{.Entity}}Command(42), CancellationToken.None);

        Assert.True(result.IsFailure);
        Assert.Equal({{.Module}}Errors.RequestFailed, result.Error);
    }
}
