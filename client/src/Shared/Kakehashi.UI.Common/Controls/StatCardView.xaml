<UserControl
    x:Class="Kakehashi.UI.Common.Controls.StatCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kakehashi.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The card's own border rather than a CardStyle: this control lives beside the pages that use
        it, not inside any one of them, and a style key defined in a page's resources is a key this
        file cannot see.
    -->
    <Border
        Padding="14,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="36"
                Height="36"
                VerticalAlignment="Center"
                Background="{x:Bind controls:StatCardView.BrushFor(Card), Mode=OneWay}"
                CornerRadius="8">
                <FontIcon
                    FontSize="16"
                    Foreground="White"
                    Glyph="{x:Bind Card.Glyph, Mode=OneWay}" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    CharacterSpacing="40"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Card.Label, Mode=OneWay}" />
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{x:Bind Card.Value, Mode=OneWay}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind Card.Detail, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
