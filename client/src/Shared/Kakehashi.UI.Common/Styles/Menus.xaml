<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="MenuFlyoutContentPadding">4</Thickness>

    <Style x:Key="ShellMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="MinWidth" Value="180" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="AccentToolbarButtonStyle"
        BasedOn="{StaticResource AccentButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        The hairline between groups of commands in a PageHeader. A style rather than a copied
        Border, because the two numbers in it — the 1px width and the 8px inset that keeps it clear
        of the group's rounded corners — are the whole thing, and they were already drifting.
    -->
    <Style x:Key="CommandBarDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="2,8" />
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style
        x:Key="DangerToolbarButtonStyle"
        BasedOn="{StaticResource ToolbarButtonStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

</ResourceDictionary>
