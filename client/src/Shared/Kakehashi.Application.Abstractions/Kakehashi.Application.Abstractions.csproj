<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kakehashi.Application.Abstractions</RootNamespace>
    <AssemblyName>Kakehashi.Application.Abstractions</AssemblyName>

    <!--
      A contract assembly: docs/COMMENTS.md makes documentation mandatory here, and this is what
      enforces it. With warnings as errors, CS1591 fails the build on an undocumented public
      member. Deliberately not solution-wide - elsewhere a doc comment is earned, not required.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kakehashi.SharedKernel\Kakehashi.SharedKernel.csproj" />
  </ItemGroup>

</Project>
