<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Kakehashi.App</RootNamespace>
    <AssemblyName>Kakehashi.App</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Win32 icon embedded in the unpackaged .exe (taskbar, Explorer, Alt+Tab). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA1416;CS8305;CS0612;CS0618;MVVMTK0045</NoWarn>
    <!-- https://github.com/microsoft/CsWin32/issues/1273 -->
    <NoWarn>$(NoWarn);IL2050</NoWarn>
    <!-- Microsoft.Xaml.Interactivity.EventTriggerBehavior is not trimmable -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
<!--
      IsAotCompatible was declared here and the four analyzers that would have checked it were
      suppressed on the next lines, with a comment saying the app is JIT-compiled and not AOT. Both
      cannot be true. The deployment is the JIT one, so the claim went rather than the suppressions:
      declaring a promise and silencing the only thing that verifies it is worse than not making it.
    -->

    <!--
      Packaging switch. Default is unpackaged (a plain .exe; simplest to build and run in CI).
      Build a packaged (MSIX) app with:  dotnet build -p:Platform=x64 -p:Packaged=true
      The packaged path additionally requires image assets under Assets\ (Visual Studio adds
      these automatically when you add a packaging project).
    -->
    <Packaged Condition="'$(Packaged)' == ''">false</Packaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Packaged)' == 'false'">
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json"
             Condition="Exists('appsettings.Development.json')"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="UI\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="CommunityToolkit.WinUI.Converters" />
    <PackageReference Include="CommunityToolkit.WinUI.Helpers" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kakehashi.App.Infrastructure\Kakehashi.App.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\Kakehashi.Interoperability\Kakehashi.Interoperability.csproj" />
    <ProjectReference Include="..\..\Shared\Kakehashi.UI.Common\Kakehashi.UI.Common.csproj" />
    <ProjectReference Include="..\..\Shared\Kakehashi.UI.Contracts\Kakehashi.UI.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Auth\Kakehashi.Modules.Auth.UI\Kakehashi.Modules.Auth.UI.csproj" />
    <ProjectReference Include="..\..\Modules\Activity\Kakehashi.Modules.Activity.UI\Kakehashi.Modules.Activity.UI.csproj" />
    <ProjectReference Include="..\..\Modules\Notes\Kakehashi.Modules.Notes.UI\Kakehashi.Modules.Notes.UI.csproj" />
  </ItemGroup>

  <!-- WinUI 3 dotnet-publish bug: XBF, PRI and Assets are not copied to the publish directory -->
  <Target Name="CopyWinUIResourcesOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_WinUIXbfFiles Include="$(OutputPath)**\*.xbf" />
      <_WinUIPriFiles Include="$(OutputPath)$(AssemblyName).pri" />
      <_WinUIAssetFiles Include="$(OutputPath)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIXbfFiles)" DestinationFiles="@(_WinUIXbfFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIAssetFiles)" DestinationFiles="@(_WinUIAssetFiles->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied WinUI resources (XBF, PRI, Assets) to publish directory." />
  </Target>

</Project>
