<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Kakehashi.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Kakehashi.UI.Common.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!--
                    The styles live in Kakehashi.UI.Common, so a feature module can use them too:
                    a module's page is compiled into its own assembly and cannot reach a dictionary
                    that only the host has. The host still merges them, because Application.Resources
                    is the one scope every page in every assembly can see.

                    The ms-appx:///<AssemblyName>/... form is what addresses a dictionary in another
                    assembly; the host's own files need no assembly segment.
                -->
                <ResourceDictionary Source="ms-appx:///Kakehashi.UI.Common/Styles/FontSizes.xaml" />
                <ResourceDictionary Source="ms-appx:///Kakehashi.UI.Common/Styles/Thickness.xaml" />
                <ResourceDictionary Source="ms-appx:///Kakehashi.UI.Common/Styles/Texts.xaml" />
                <ResourceDictionary Source="ms-appx:///Kakehashi.UI.Common/Styles/BasicInputs.xaml" />
                <ResourceDictionary Source="ms-appx:///Kakehashi.UI.Common/Styles/Menus.xaml" />
                <ResourceDictionary Source="ms-appx:///Kakehashi.UI.Common/Styles/SelectorBar.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
