<Page
    x:Class="Kakehashi.App.UI.NavigationLayoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Kakehashi.UI.Common.Behaviors"
    xmlns:controls="using:Kakehashi.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kakehashi.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,12,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Title="Navigation"
            Grid.Row="0"
            Section="Administration">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="New heading"
                    Command="{x:Bind ViewModel.NewHeadingCommand}"
                    Style="{StaticResource AccentToolbarButtonStyle}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xE710;" />
                        <TextBlock VerticalAlignment="Center" Text="New heading" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource CommandBarDividerStyle}" />
                <Button
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!--
            The one thing this screen cannot do, said before somebody looks for the control. A screen
            full of editable fields invites the assumption that everything on it is editable, and the
            permission column would otherwise read as something a person forgot to make work.
        -->
        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="Arranging the pane never changes who may open a screen. Each screen's permission is declared beside its code and enforced on every request, so the worst a change here can do is hide something."
            Severity="Informational" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: the headings.  -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Margin="16,14,16,0"
                        Style="{StaticResource SectionLabelStyle}"
                        Text="HEADINGS" />

                    <ListView
                        x:Name="HeadingList"
                        Grid.Row="1"
                        Padding="8,0,8,0"
                        ItemsSource="{x:Bind ViewModel.Headings}"
                        SelectedItem="{x:Bind ViewModel.SelectedHeading, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:NavHeadingViewModel">
                                <Grid
                                    Padding="4,8"
                                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Id}" />
                                    </StackPanel>
                                    <!--  The product's own headings, marked so the missing delete button reads as deliberate.  -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsSystem}">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="BUILT IN" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  The editor for whichever heading is selected.  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="16,0,16,14"
                        Spacing="8"
                        Visibility="{x:Bind local:NavigationLayoutPage.WhenPresent(ViewModel.SelectedHeading), Mode=OneWay}">
                        <Border
                            Height="1"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <TextBox
                            Header="Name"
                            Text="{x:Bind ViewModel.SelectedHeading.Title, Mode=TwoWay}" />
                        <NumberBox
                            Header="Position"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.SelectedHeading.Position, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.SaveHeadingCommand}"
                                Content="Save"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                AutomationProperties.Name="Delete heading"
                                Command="{x:Bind ViewModel.DeleteHeadingCommand}"
                                Content="Delete"
                                IsEnabled="{x:Bind ViewModel.SelectedHeading.CanDelete, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  RIGHT: every destination this build has, and where it sits.  -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,14,16,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource SectionLabelStyle}"
                            Text="SCREENS" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    </Grid>

                    <ScrollViewer
                        Grid.Row="1"
                        Padding="16,0,16,14"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Destinations}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:NavDestinationViewModel">
                                    <Border
                                        Padding="12"
                                        Background="{ThemeResource SubtleFillColorTransparentBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!--
                                                Which heading it sits under. Two things here are
                                                deliberate and were both learned the hard way.
                                                Each row binds its OWN snapshot of the choices:
                                                clearing a collection a picker is bound to blanks
                                                its selection, and the first version of this screen
                                                read that as somebody moving every row it drew.
                                                And the selection binds to a property on the row
                                                rather than to a handler that reads the row back out
                                                of Tag: the repeater recycles these controls, and
                                                the value binding lands before the Tag binding does,
                                                so the handler saw the new heading with the previous
                                                row still attached. A property setter cannot be
                                                wrong about which row it is on.
                                            -->
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Width="170"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Heading"
                                                IsEnabled="{x:Bind local:NavigationLayoutPage.Not(IsOrphan)}"
                                                ItemsSource="{x:Bind Headings}"
                                                SelectedItem="{x:Bind Heading, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="local:NavHeadingChoice">
                                                        <TextBlock Text="{x:Bind Title}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="2">
                                                <!--
                                                    Disabled for a row this build no longer has a
                                                    screen for: it sits in no heading, so there is
                                                    nothing to reorder it among.
                                                -->
                                                <Button
                                                    Width="32"
                                                    AutomationProperties.Name="Move up"
                                                    Command="{x:Bind MoveUpCommand}"
                                                    IsEnabled="{x:Bind local:NavigationLayoutPage.Not(IsOrphan)}"
                                                    ToolTipService.ToolTip="Move up">
                                                    <FontIcon FontSize="12" Glyph="&#xE70E;" />
                                                </Button>
                                                <Button
                                                    Width="32"
                                                    AutomationProperties.Name="Move down"
                                                    Command="{x:Bind MoveDownCommand}"
                                                    IsEnabled="{x:Bind local:NavigationLayoutPage.Not(IsOrphan)}"
                                                    ToolTipService.ToolTip="Move down">
                                                    <FontIcon FontSize="12" Glyph="&#xE70D;" />
                                                </Button>
                                            </StackPanel>

                                            <!--
                                                Offered or not. Hiding a screen is not a permission:
                                                it takes the row out of everybody's pane, and the
                                                endpoints behind it stay exactly as protected as
                                                they were.
                                            -->
                                            <ToggleSwitch
                                                Grid.Row="0"
                                                Grid.Column="3"
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Show in the pane"
                                                IsOn="{x:Bind IsVisible, Mode=TwoWay}"
                                                OffContent=""
                                                OnContent=""
                                                Tag="{x:Bind}"
                                                Toggled="OnVisibilityToggled" />

                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="4"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBox
                                                    Width="220"
                                                    AutomationProperties.Name="Label override"
                                                    PlaceholderText="{x:Bind DefaultTitle}"
                                                    Text="{x:Bind Title, Mode=TwoWay}" />
                                                <TextBox
                                                    Width="130"
                                                    AutomationProperties.Name="Icon name override"
                                                    PlaceholderText="{x:Bind local:NavigationLayoutPage.IconHint(DefaultIcon)}"
                                                    Text="{x:Bind Icon, Mode=TwoWay}" />
                                                <Button
                                                    AutomationProperties.Name="Apply label"
                                                    Command="{x:Bind ApplyCommand}"
                                                    Content="Apply" />
                                                <Button
                                                    AutomationProperties.Name="Use the default label"
                                                    Command="{x:Bind ResetCommand}"
                                                    Content="Default" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
