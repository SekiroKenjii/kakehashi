<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Kakehashi.App.UI.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Kakehashi.UI.Common.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnShellPageLoaded"
    Unloaded="OnShellPageUnloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  The item template swaps the content anchor to 0,0,0,0 when the pane is compact,
              which would shift custom item content (e.g. the Account avatar) by 4px relative to
              the icon column. Pin it to the expanded-mode value so the anchor never moves; for
              default items the difference is invisible (their content is clipped when compact).  -->
        <Thickness x:Key="NavigationViewCompactItemContentPresenterMargin">4,-1,8,-1</Thickness>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Kakehashi"
            BackRequested="OnTitleBarBackRequested"
            Canvas.ZIndex="1"
            IsBackButtonVisible="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested"
            Subtitle="Experimental">
            <TitleBar.LeftHeader>
                <ImageIcon
                    Height="16"
                    Margin="8,0"
                    Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-unplated.png" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <!--  Left sidebar, page container  -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            Canvas.ZIndex="0"
            ExpandedModeThresholdWidth="600"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsPaneVisible="True"
            IsSettingsVisible="True"
            IsTabStop="False"
            ItemInvoked="OnNavViewItemInvoked"
            OpenPaneLength="240"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            SelectionChanged="OnNavViewSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="Home"
                    AutomationProperties.AutomationId="Home"
                    Content="Home"
                    Icon="Home"
                    Tag="Home" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
            </NavigationView.FooterMenuItems>

            <i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind}" />
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  In-app notification  -->
                <InfoBar
                    x:Name="AppNotificationBar"
                    IsClosable="True"
                    IsOpen="False" />

                <!--  Page container  -->
                <Frame
                    x:Name="NavFrame"
                    Grid.Row="1"
                    Margin="{StaticResource NavigationViewPaneContentGridMargin}" />

                <!--  Status bar  -->
                <Grid
                    Grid.Row="2"
                    Padding="16,4"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
