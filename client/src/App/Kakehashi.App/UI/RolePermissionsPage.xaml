<Page
    x:Class="Kakehashi.App.UI.RolePermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Kakehashi.UI.Common.Behaviors"
    xmlns:controls="using:Kakehashi.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kakehashi.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Kakehashi.App.Services"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="CompactToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,12,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Title="Role permissions"
            Grid.Row="0"
            Section="Administration">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="New role"
                    Command="{x:Bind ViewModel.CreateCommand}"
                    Style="{StaticResource AccentToolbarButtonStyle}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xE710;" />
                        <TextBlock VerticalAlignment="Center" Text="New role" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Audit log"
                    Command="{x:Bind ViewModel.ToggleAuditCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanViewAudit, Mode=OneWay}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xE81C;" />
                        <TextBlock VerticalAlignment="Center" Text="Audit log" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource CommandBarDividerStyle}" />
                <Button
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!--
            The unsaved-changes bar. Present only while there is something to save, which is what
            makes it a warning rather than furniture: an administrator who navigates away with it
            showing has been told.
        -->
        <Border
            Grid.Row="1"
            Padding="14,8"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="&#xE7BA;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Text="{x:Bind local:RolePermissionsPage.DescribeChanges(ViewModel.ChangedCount), Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ChangeSummary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Discard changes"
                    Command="{x:Bind ViewModel.DiscardCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE7A7;" />
                        <TextBlock Text="Discard" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="4"
                    AutomationProperties.Name="Save changes"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE74E;" />
                        <TextBlock Text="Save changes" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  Roles on the left, the selected role's matrix on the right.  -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: role cards.  -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,12,10,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionLabelStyle}"
                            Text="ROLES" />
                        <Button
                            Padding="5"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.CreateCommand}"
                            ToolTipService.ToolTip="New role">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                        </Button>
                    </Grid>

                    <ListView
                        Grid.Row="2"
                        Padding="4,0,4,8"
                        AutomationProperties.AutomationId="RoleList"
                        ItemsSource="{x:Bind ViewModel.Roles}"
                        SelectedItem="{x:Bind ViewModel.SelectedRole, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="4,2" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:RoleRow">
                                <!--
                                    Without this the row's accessible name is the record's
                                    ToString() — "RoleRow { Id = d5ce92d9-… }" read aloud.
                                -->
                                <StackPanel AutomationProperties.Name="{x:Bind Name}" Spacing="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{x:Bind local:AdminFormat.Initials(Name)}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE8D7;" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind local:RolePermissionsPage.DescribePerms(PermissionCount, PermissionTotal)}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE716;" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind local:RolePermissionsPage.DescribeUsers(AccountCount)}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ProgressBar
                                        MinHeight="4"
                                        Maximum="{x:Bind PermissionTotal}"
                                        Value="{x:Bind PermissionCount}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  RIGHT: the permission matrix, or the audit trail in its place.  -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Matrix header: who is being edited, and the role-level actions.  -->
                    <Grid
                        Grid.Row="0"
                        Padding="16,12"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="10">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{x:Bind local:RolePermissionsPage.InitialsOf(ViewModel.SelectedRole), Mode=OneWay}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind local:RolePermissionsPage.NameOf(ViewModel.SelectedRole), Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind local:RolePermissionsPage.DescribeRoleSub(ViewModel.SelectedRole), Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Clone role"
                            Command="{x:Bind ViewModel.CloneCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                <TextBlock Text="Clone role" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="3"
                            AutomationProperties.Name="Edit role details"
                            Command="{x:Bind ViewModel.EditDetailsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                <TextBlock Text="Edit details" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="4"
                            Padding="8,5"
                            AutomationProperties.Name="More role actions"
                            ToolTipService.ToolTip="More">
                            <FontIcon FontSize="13" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <!--
                                        Disabled for a role the product ships. The server refuses
                                        those with a sentence, but offering the item at all walked
                                        an administrator through a permanent-deletion confirmation
                                        for something that was never going to happen.
                                    -->
                                    <MenuFlyoutItem
                                        Command="{x:Bind ViewModel.DeleteCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanDeleteSelectedRole, Mode=OneWay}"
                                        Text="Delete role">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!--  Filter toolbar: search, the state chips, and the running total.  -->
                    <Grid
                        Grid.Row="1"
                        Padding="16,8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="10">
                        <!--
                            The running total takes the star column, so whatever is left over goes
                            to it and the chips keep their natural width. Squeezing the chips
                            instead cut "Changed" in half; squeezing a short right-aligned label
                            costs nothing, because there is always room for it.
                        -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <AutoSuggestBox
                            Grid.Column="0"
                            MinWidth="180"
                            MaxWidth="240"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="PermissionSearch"
                            PlaceholderText="Search permissions by name or key..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <SelectorBar
                            x:Name="FilterBar"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            SelectionChanged="OnFilterChipChanged">
                            <SelectorBarItem x:Name="ChipAll" Text="All" />
                            <SelectorBarItem Text="Enabled" />
                            <SelectorBarItem Text="Disabled" />
                            <SelectorBarItem Text="Changed" />
                        </SelectorBar>

                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.GrantSummary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!--  The matrix itself.  -->
                    <!--
                        Horizontal scrolling off, and this is not cosmetic. A ScrollViewer that
                        allows it measures its child at infinite width, so the widest permission row
                        set the whole grid's width and the card grew past the window — taking the
                        running total off the right edge with it.
                    -->
                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        Visibility="{x:Bind local:RolePermissionsPage.Not(ViewModel.IsAuditOpen), Mode=OneWay}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PermissionGroupViewModel">
                                    <StackPanel>
                                        <!--  Category header.  -->
                                        <Grid
                                            Padding="16,10"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="7">
                                                <FontIcon
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Glyph="{x:Bind local:RolePermissionsPage.GroupGlyph(Name)}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}" />
                                            <Border
                                                Grid.Column="2"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Summary, Mode=OneWay}" />
                                            </Border>
                                            <Button
                                                Grid.Column="3"
                                                Padding="9,3"
                                                Command="{x:Bind EnableAllCommand}"
                                                Content="All on"
                                                FontSize="11" />
                                            <Button
                                                Grid.Column="4"
                                                Padding="9,3"
                                                Command="{x:Bind DisableAllCommand}"
                                                Content="All off"
                                                FontSize="11" />
                                        </Grid>

                                        <!--  The rows the current filter lets through.  -->
                                        <ItemsControl ItemsSource="{x:Bind Visible}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:GrantViewModel">
                                                    <Border
                                                        Padding="17,10,16,10"
                                                        Background="{x:Bind local:RolePermissionsPage.ChangedBackground(IsChanged), Mode=OneWay}"
                                                        BorderBrush="{x:Bind local:RolePermissionsPage.ChangedBorder(IsChanged), Mode=OneWay}"
                                                        BorderThickness="3,0,0,1">
                                                        <Grid ColumnSpacing="14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Spacing="3">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        FontWeight="SemiBold"
                                                                        Text="{x:Bind Name}" />
                                                                    <Border
                                                                        Padding="7,1"
                                                                        VerticalAlignment="Center"
                                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                        CornerRadius="4"
                                                                        Opacity="0.85">
                                                                        <TextBlock
                                                                            FontFamily="Cascadia Mono,Consolas"
                                                                            FontSize="11"
                                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                            Text="{x:Bind Key}" />
                                                                    </Border>
                                                                    <Border
                                                                        Padding="7,1"
                                                                        VerticalAlignment="Center"
                                                                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                                        CornerRadius="8"
                                                                        Visibility="{x:Bind IsHighRisk}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <FontIcon
                                                                                FontSize="9"
                                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                                Glyph="&#xE7BA;" />
                                                                            <TextBlock
                                                                                FontSize="10"
                                                                                FontWeight="SemiBold"
                                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                                Text="High risk" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border
                                                                        Padding="7,1"
                                                                        VerticalAlignment="Center"
                                                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                                        CornerRadius="8"
                                                                        Visibility="{x:Bind IsChanged, Mode=OneWay}">
                                                                        <TextBlock
                                                                            FontSize="10"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                            Text="Changed" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Text="{x:Bind Description}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!--
                                                                The row-level half. Two conditions, and
                                                                they are different questions. Present
                                                                only where the module enforcing this
                                                                permission actually narrows its queries
                                                                on the scope — offering the choice
                                                                anywhere else made a row-level promise
                                                                on a key nothing narrows, stored the
                                                                answer, showed it back, and changed
                                                                nothing. Enabled only while the
                                                                permission is on: a scope on a grant
                                                                nobody holds reads as meaningful and is
                                                                not.
                                                            -->
                                                            <ComboBox
                                                                Grid.Column="1"
                                                                MinWidth="108"
                                                                VerticalAlignment="Center"
                                                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                                SelectedValue="{x:Bind Scope, Mode=TwoWay}"
                                                                SelectedValuePath="Tag"
                                                                ToolTipService.ToolTip="Which rows this reaches"
                                                                Visibility="{x:Bind IsScoped}">
                                                                <ComboBoxItem Content="Own rows" Tag="own" />
                                                                <ComboBoxItem Content="Team rows" Tag="team" />
                                                                <ComboBoxItem Content="All rows" Tag="all" />
                                                            </ComboBox>

                                                            <!--
                                                                Two switches, one shown: the high-risk
                                                                rows get the red fill the mockup gives
                                                                them, and per-instance resources are the
                                                                only way to recolour a ToggleSwitch.
                                                            -->
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <ToggleSwitch
                                                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                    Style="{StaticResource CompactToggleStyle}"
                                                                    Visibility="{x:Bind IsOrdinaryRisk}" />
                                                                <ToggleSwitch
                                                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                    Style="{StaticResource CompactToggleStyle}"
                                                                    Visibility="{x:Bind IsHighRisk}">
                                                                    <ToggleSwitch.Resources>
                                                                        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#C42B1C" />
                                                                        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#B02418" />
                                                                        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#9C2015" />
                                                                        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#C42B1C" />
                                                                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#B02418" />
                                                                        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#9C2015" />
                                                                    </ToggleSwitch.Resources>
                                                                </ToggleSwitch>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--
                        The audit trail replaces the matrix rather than sitting beside it: both want
                        the whole width, and a screen showing two long lists at once shows neither.
                    -->
                    <ListView
                        Grid.Row="2"
                        AutomationProperties.AutomationId="AuditList"
                        ItemsSource="{x:Bind ViewModel.AuditEntries}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.IsAuditOpen, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:AuditRow">
                                <StackPanel Padding="4,8" Spacing="2">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind local:RolePermissionsPage.DescribeAudit(Action, RoleName, PermissionKey)}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind local:RolePermissionsPage.DescribeActor(ActorName, OccurredAt, Detail)}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <ProgressRing
            Grid.Row="2"
            Width="36"
            Height="36"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <!--
            What a caller without the permission sees. The server refuses every call this page
            makes, so the alternative is a screen of empty lists and a stack of error bars.
        -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="-24,-12,-24,-20"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{x:Bind local:RolePermissionsPage.Not(ViewModel.IsPermitted), Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon FontSize="32" Glyph="&#xE72E;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="You do not have access to role permissions" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ask an administrator for the roles manage permission." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
