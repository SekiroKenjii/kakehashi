<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Kakehashi.App.UI.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Kakehashi.UI.Common.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:Kakehashi.App.UI"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="CaptionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="50" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaptionIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  Transparent full-width row button used for checklist and resource rows.  -->
        <Style x:Key="RowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <!--  A feature-module tile that looks like a card but is clickable.  -->
        <Style x:Key="ModuleCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="StatusKeyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            Padding="24"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <!--  Breadcrumb  -->
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Kakehashi" />
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76C;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Home" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>

                <!--  LEFT column  -->
                <StackPanel Spacing="16">

                    <!--  Greeting hero  -->
                    <Border Padding="24,20" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <PersonPicture
                                    Width="64"
                                    Height="64"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    DisplayName="{x:Bind ViewModel.AvatarName, Mode=OneWay}"
                                    Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}" />
                                <Ellipse
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,1,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    StrokeThickness="2"
                                    Visibility="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.GreetingText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.DateText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Explore modules"
                                Click="OnExploreModulesClick"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE71D;" />
                                    <TextBlock Text="Explore modules" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!--  Getting started  -->
                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsGettingStartedVisible, Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE945;" Style="{StaticResource CaptionIconStyle}" />
                                    <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="GETTING STARTED" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Padding="6,4"
                                    AutomationProperties.Name="Dismiss"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.DismissGettingStartedCommand}"
                                    ToolTipService.ToolTip="Dismiss">
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar
                                    VerticalAlignment="Center"
                                    Maximum="4"
                                    Value="{x:Bind ViewModel.StepsProgress, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.StepsProgressText, Mode=OneWay}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Steps, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ui:GettingStartedStep">
                                        <!--
                                            A step with nothing to do is not a control. It stays in
                                            the list because it is a checklist item, but it does not
                                            take focus and does not answer a click — pressing a
                                            full-width button and having nothing happen reads as a
                                            broken app rather than as a step that needs no help.
                                        -->
                                        <Button
                                            AutomationProperties.Name="{x:Bind Title}"
                                            Click="OnStepClick"
                                            IsHitTestVisible="{x:Bind HasAction}"
                                            IsTabStop="{x:Bind HasAction}"
                                            Style="{StaticResource RowButtonStyle}"
                                            Tag="{x:Bind}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid
                                                    Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center">
                                                    <Border
                                                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Visibility="{x:Bind IsNotDone}" />
                                                    <Border
                                                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                                                        CornerRadius="12"
                                                        Visibility="{x:Bind IsDone}">
                                                        <FontIcon
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                            Glyph="&#xE73E;" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Title}"
                                                        Visibility="{x:Bind IsNotDone}" />
                                                    <TextBlock
                                                        FontSize="13"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind Title}"
                                                        TextDecorations="Strikethrough"
                                                        Visibility="{x:Bind IsDone}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Subtitle}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <FontIcon
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Glyph="&#xE76C;"
                                                    Visibility="{x:Bind ShowsChevron}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Feature modules  -->
                    <Border x:Name="ModulesCard" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE71D;" Style="{StaticResource CaptionIconStyle}" />
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="{x:Bind ViewModel.ModulesHeader, Mode=OneWay}" />
                            </StackPanel>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModuleCards, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="12"
                                        MinItemWidth="300"
                                        MinRowSpacing="12" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="ui:ModuleCardItem">
                                        <Button
                                            AutomationProperties.Name="{x:Bind Name}"
                                            Click="OnModuleCardClick"
                                            Style="{StaticResource ModuleCardButtonStyle}"
                                            Tag="{x:Bind}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--
                                                        Two tiles, one shown at a time: accent for
                                                        a module you may use, subdued with a
                                                        padlock for one an administrator withheld.
                                                        Two elements rather than a converter, which
                                                        is how the rest of this codebase switches
                                                        on a bool.
                                                    -->
                                                    <Border
                                                        Width="38"
                                                        Height="38"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="9"
                                                        Visibility="{x:Bind CanOpen}">
                                                        <FontIcon
                                                            FontSize="16"
                                                            Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}"
                                                            Glyph="{x:Bind IconGlyph}" />
                                                    </Border>
                                                    <Border
                                                        Width="38"
                                                        Height="38"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Visibility="{x:Bind IsWithheld}">
                                                        <FontIcon
                                                            FontSize="15"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Glyph="&#xE72E;" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="8,2"
                                                        Style="{StaticResource PillStyle}"
                                                        Visibility="{x:Bind CanOpen}">
                                                        <TextBlock
                                                            CharacterSpacing="30"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind Badge}" />
                                                    </Border>
                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="8,2"
                                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                        CornerRadius="10"
                                                        Visibility="{x:Bind IsWithheld}">
                                                        <TextBlock
                                                            CharacterSpacing="30"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                            Text="{x:Bind Badge}" />
                                                    </Border>
                                                    <Button
                                                        Grid.Column="3"
                                                        Padding="5,4"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.HelpText="{x:Bind Name}"
                                                        AutomationProperties.Name="Detach module"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="OnDetachModuleClick"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Detach module"
                                                        Visibility="{x:Bind CanDetach}">
                                                        <FontIcon
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Glyph="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock
                                                    MinHeight="32"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="2"
                                                    Text="{x:Bind Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind FootText}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="5"
                                                        Visibility="{x:Bind CanOpen}">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Text="Open" />
                                                        <FontIcon FontSize="11" Glyph="&#xE72A;" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="5"
                                                        Visibility="{x:Bind IsWithheld}">
                                                        <FontIcon
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Glyph="&#xE72E;" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="Locked" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <!--
                                Attach entry point: lists detached modules to re-attach, and
                                otherwise points developers at the module contract.
                            -->
                            <Button
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="Register your module"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRegisterModuleClick">
                                <Grid MinHeight="104">
                                    <Rectangle
                                        Fill="Transparent"
                                        RadiusX="8"
                                        RadiusY="8"
                                        Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                        StrokeDashArray="4,3"
                                        StrokeThickness="1" />
                                    <StackPanel
                                        Margin="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <FontIcon
                                            FontSize="15"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE710;" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Text="Register your module" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Cascadia Mono,Consolas"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="IModule → nav rail" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  RIGHT column  -->
                <StackPanel Grid.Column="1" Spacing="16">

                    <!--  Backend status  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE977;" Style="{StaticResource CaptionIconStyle}" />
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="BACKEND" />
                            </StackPanel>
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource StatusKeyStyle}" Text="Status" />
                                <Grid Grid.Column="1">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource StatusValueStyle}"
                                        Text="{x:Bind ViewModel.BackendStatusText, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsBackendNeutral, Mode=OneWay}" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind ViewModel.IsBackendConnected, Mode=OneWay}">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Style="{StaticResource StatusValueStyle}"
                                            Text="{x:Bind ViewModel.BackendStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind ViewModel.IsBackendOffline, Mode=OneWay}">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource StatusValueStyle}"
                                            Text="{x:Bind ViewModel.BackendStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource StatusKeyStyle}"
                                    Text="Endpoint" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource StatusValueStyle}"
                                    Text="{x:Bind ViewModel.BackendEndpointText}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource StatusKeyStyle}"
                                    Text="Protocol" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource StatusValueStyle}"
                                    Text="{x:Bind ViewModel.BackendProtocolText}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource StatusKeyStyle}"
                                    Text="Client" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource StatusValueStyle}"
                                    Text="{x:Bind ViewModel.ClientVersionText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Recent activity  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE81C;" Style="{StaticResource CaptionIconStyle}" />
                                    <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="RECENT ACTIVITY" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    Visibility="{x:Bind ViewModel.HasActivityPaging, Mode=OneWay}">
                                    <Button
                                        AutomationProperties.Name="Previous page"
                                        Command="{x:Bind ViewModel.ActivityPrevPageCommand}"
                                        Style="{StaticResource PagerButtonStyle}">
                                        <FontIcon FontSize="11" Glyph="&#xE76B;" />
                                    </Button>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ViewModel.ActivityPageLabel, Mode=OneWay}" />
                                    <Button
                                        AutomationProperties.Name="Next page"
                                        Command="{x:Bind ViewModel.ActivityNextPageCommand}"
                                        Style="{StaticResource PagerButtonStyle}">
                                        <FontIcon FontSize="11" Glyph="&#xE76C;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ui:HomeActivityItem">
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="32"
                                                Height="32"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <Grid>
                                                    <FontIcon
                                                        FontSize="14"
                                                        Glyph="{x:Bind Glyph}"
                                                        Visibility="{x:Bind IsNeutral}" />
                                                    <FontIcon
                                                        FontSize="14"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Glyph="{x:Bind Glyph}"
                                                        Visibility="{x:Bind IsPositive}" />
                                                    <FontIcon
                                                        FontSize="14"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Glyph="{x:Bind Glyph}"
                                                        Visibility="{x:Bind IsAlert}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono,Consolas"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Top"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind TimeText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="No recent activity yet."
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasNoActivity, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Resources  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE8F1;" Style="{StaticResource CaptionIconStyle}" />
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="RESOURCES" />
                            </StackPanel>
                            <Button
                                AutomationProperties.Name="WinUI 3 documentation"
                                Command="{x:Bind ViewModel.OpenLinkCommand}"
                                CommandParameter="https://learn.microsoft.com/windows/apps/winui/winui3/"
                                Style="{StaticResource RowButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE8A5;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="WinUI 3 documentation" />
                                    <FontIcon
                                        Grid.Column="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE8A7;" />
                                </Grid>
                            </Button>
                            <Button
                                AutomationProperties.Name="Windows App SDK repository"
                                Command="{x:Bind ViewModel.OpenLinkCommand}"
                                CommandParameter="https://github.com/microsoft/WindowsAppSDK"
                                Style="{StaticResource RowButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE943;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Windows App SDK repository" />
                                    <FontIcon
                                        Grid.Column="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE8A7;" />
                                </Grid>
                            </Button>
                            <Button
                                AutomationProperties.Name="Windows App SDK releases"
                                Command="{x:Bind ViewModel.OpenLinkCommand}"
                                CommandParameter="https://github.com/microsoft/WindowsAppSDK/releases"
                                Style="{StaticResource RowButtonStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE7C3;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="Windows App SDK releases" />
                                    <FontIcon
                                        Grid.Column="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE8A7;" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ContentDialog
                x:Name="DetachModuleDialog"
                Title="Detach module"
                CloseButtonText="Cancel"
                DefaultButton="Close"
                PrimaryButtonText="Detach">
                <TextBlock
                    MaxWidth="360"
                    Text="{x:Bind ViewModel.DetachPrompt, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </ContentDialog>

            <ContentDialog
                x:Name="AttachModuleDialog"
                Title="Register a module"
                CloseButtonText="Close"
                DefaultButton="Close">
                <StackPanel MinWidth="360" Spacing="8">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Every compiled-in module is attached. To add a new one, implement IModule and register it in ModuleCatalog — it appears in the nav rail automatically."
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasNoDetachedModules, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DetachedModules, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="ui:DetachedModuleListItem">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="OnAttachModuleClick"
                                        Content="Attach"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind CanAttach}" />
                                    <!--
                                        Listed rather than hidden: a module that silently is not
                                        offered looks like one that does not exist, and the user
                                        needs to know there is somebody to ask.
                                    -->
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind IsWithheld}">
                                        <FontIcon
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xE72E;" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="Locked" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentDialog>
        </StackPanel>
    </ScrollViewer>
</Page>
