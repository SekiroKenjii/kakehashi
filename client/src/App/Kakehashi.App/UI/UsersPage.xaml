<Page
    x:Class="Kakehashi.App.UI.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Kakehashi.UI.Common.Behaviors"
    xmlns:controls="using:Kakehashi.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kakehashi.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:Kakehashi.App.Services"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ColumnHeadStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MonoTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
        </Style>

        <!--  One card, four times, so the four stay identical.  -->
        <DataTemplate x:Key="StatCardTemplate" x:DataType="local:StatCard">
            <Border Padding="14,12" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="{x:Bind local:UsersPage.StatBrush(Kind)}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="White"
                            Glyph="{x:Bind Glyph}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{x:Bind Label}" />
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{x:Bind Value}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Detail}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,12,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The standard page header. Section + title on the left, the page's commands in the
            bordered group on the right; the control owns the layout so every screen agrees.
        -->
        <controls:PageHeader
            Grid.Row="0"
            Section="Administration"
            Title="Users">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button AutomationProperties.Name="Add user"
                    Command="{x:Bind ViewModel.AddUserCommand}"
                    Style="{StaticResource AccentToolbarButtonStyle}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xE710;" />
                        <TextBlock VerticalAlignment="Center" Text="Add user" />
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="Export"
                    Command="{x:Bind ViewModel.ExportCommand}"
                    Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xEDE1;" />
                        <TextBlock VerticalAlignment="Center" Text="Export" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource CommandBarDividerStyle}" />
                <Button
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!--  The four stat cards. Counted over the whole set, never the filtered one.  -->
        <!--
            An ItemsRepeater rather than an ItemsControl, for the layout: UniformGridLayout with
            ItemsStretch=Fill gives the four equal columns the mockup has, where a horizontal
            StackPanel would huddle them at the left of a wide window.
        -->
        <ItemsRepeater
            Grid.Row="1"
            ItemTemplate="{StaticResource StatCardTemplate}"
            ItemsSource="{x:Bind ViewModel.StatCards}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="4"
                    MinColumnSpacing="12"
                    Orientation="Horizontal" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: filter toolbar + user table.  -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Padding="12,10"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <AutoSuggestBox
                            Grid.Column="0"
                            MaxWidth="320"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="UserSearch"
                            PlaceholderText="Search by name or email..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox
                            Grid.Column="1"
                            MinWidth="110"
                            ItemsSource="{x:Bind ViewModel.RoleFilters}"
                            SelectedItem="{x:Bind ViewModel.RoleFilter, Mode=TwoWay}" />

                        <ComboBox
                            Grid.Column="2"
                            MinWidth="110"
                            ItemsSource="{x:Bind ViewModel.StatusFilters}"
                            SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CountSummary, Mode=OneWay}" />
                    </Grid>

                    <!--  Column heads. The widths repeat in the row template — keep them in step.  -->
                    <Grid
                        Grid.Row="1"
                        Padding="16,8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="12">
                        <!--
                            Widths repeat in the row template below — keep the two in step. Sized
                            for 1280 effective pixels (a 2560 display at 200%), where the earlier
                            widths left the name column too narrow to hold a name.
                        -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="95" />
                            <ColumnDefinition Width="85" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource ColumnHeadStyle}"
                            Text="USER" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource ColumnHeadStyle}"
                            Text="ROLE" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource ColumnHeadStyle}"
                            Text="STATUS" />
                        <TextBlock
                            Grid.Column="3"
                            Style="{StaticResource ColumnHeadStyle}"
                            Text="LAST LOGIN" />
                        <TextBlock
                            Grid.Column="4"
                            Style="{StaticResource ColumnHeadStyle}"
                            Text="CREATED" />
                    </Grid>

                    <ListView
                        x:Name="UserList"
                        Grid.Row="2"
                        AutomationProperties.AutomationId="UserList"
                        ItemsSource="{x:Bind ViewModel.Users}"
                        SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:UserRow">
                                <!--
                                    Without this the row's accessible name is the record's
                                    ToString() — every field, including the id, read aloud.
                                -->
                                <Grid AutomationProperties.Name="{x:Bind DisplayName}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="85" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                        <Border
                                            Width="32"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="16">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{x:Bind local:AdminFormat.Initials(DisplayName)}" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource MonoTextStyle}"
                                                Text="{x:Bind Email}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Border
                                            Padding="10,3"
                                            Background="{x:Bind local:UsersPage.FirstRoleBackground(RoleNames)}"
                                            CornerRadius="11"
                                            Visibility="{x:Bind local:UsersPage.HasAnyRole(RoleNames)}">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind local:UsersPage.FirstRoleForeground(RoleNames)}"
                                                Text="{x:Bind local:UsersPage.FirstRole(RoleNames)}" />
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind local:UsersPage.MoreRoles(RoleNames)}"
                                            Visibility="{x:Bind local:UsersPage.HasMoreRoles(RoleNames)}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{x:Bind local:UsersPage.StatusBrush(IsActive, LastSignInAt)}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{x:Bind local:UsersPage.StatusBrush(IsActive, LastSignInAt)}"
                                            Text="{x:Bind local:UsersPage.DescribeStatus(IsActive, LastSignInAt)}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind local:UsersPage.DescribeLastSignIn(LastSignInAt)}" />

                                    <TextBlock
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind local:UsersPage.DescribeCreated(CreatedAt)}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  RIGHT: the detail panel. Empty state until somebody is selected.  -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind local:UsersPage.Not(ViewModel.IsDetailOpen), Mode=OneWay}">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE77B;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select a user" />
                    </StackPanel>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        Visibility="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
                        <StackPanel>
                            <!--  Hero: avatar, name, email, status.  -->
                            <StackPanel
                                Padding="20,22,20,16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Spacing="4">
                                <Border
                                    Width="72"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="36">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="26"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="{x:Bind local:UsersPage.InitialsOf(ViewModel.SelectedUser), Mode=OneWay}" />
                                </Border>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind local:UsersPage.DescribeSelection(ViewModel.SelectedUser), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource MonoTextStyle}"
                                    Text="{x:Bind local:UsersPage.Email(ViewModel.SelectedUser), Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind local:UsersPage.SelectedStatusBrush(ViewModel.SelectedUser), Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{x:Bind local:UsersPage.SelectedStatusBrush(ViewModel.SelectedUser), Mode=OneWay}"
                                        Text="{x:Bind local:UsersPage.SelectedStatus(ViewModel.SelectedUser), Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!--
                                The action row from the mockup. Edit is the primary one; the
                                overflow holds what is useful but rarely wanted, so the two things
                                somebody came here to do stay one click away.
                            -->
                            <Grid
                                Padding="20,12"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                ColumnSpacing="6">
                                <!--
                                    Edit sizes to its own label and Reset password takes the rest:
                                    splitting the row evenly gave the longer label less room than
                                    the shorter one, and it was the one that got cut.
                                -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Edit user"
                                    Command="{x:Bind ViewModel.EditCommand}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                        <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                        <TextBlock FontSize="12" Text="Edit" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Reset password"
                                    Command="{x:Bind ViewModel.ResetPasswordCommand}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                        <FontIcon FontSize="12" Glyph="&#xE8D7;" />
                                        <TextBlock FontSize="12" Text="Reset password" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    Padding="10,5"
                                    AutomationProperties.Name="More actions"
                                    ToolTipService.ToolTip="More actions">
                                    <FontIcon FontSize="13" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Command="{x:Bind ViewModel.CopyEmailCommand}" Text="Copy email">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Command="{x:Bind ViewModel.CopyAccountIdCommand}" Text="Copy account ID">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Command="{x:Bind ViewModel.SignOutEverywhereCommand}" Text="Sign out everywhere">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7E8;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <StackPanel Padding="20,14" Spacing="18">
                                <!--  Account information.  -->
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ACCOUNT INFORMATION" />
                                    <Grid ColumnSpacing="8" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Email" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            FontSize="11.5"
                                            Style="{StaticResource MonoTextStyle}"
                                            Text="{x:Bind local:UsersPage.Email(ViewModel.SelectedUser), Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Phone" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{x:Bind local:UsersPage.OrDash(ViewModel.SelectedUser.Phone), Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Team" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{x:Bind local:UsersPage.OrDash(ViewModel.SelectedUser.TeamId), Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Created" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            FontSize="12"
                                            Text="{x:Bind local:UsersPage.CreatedLine(ViewModel.SelectedUser), Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>

                                <!--
                                    Roles. A chip with its own remove button, wrapped rather than
                                    stacked: they are short, there are few, and a vertical list of
                                    one-word rows each with a full-width button was the previous
                                    design's mistake.
                                -->
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ROLES" />

                                    <!--
                                        A chip is as wide as the word inside it, and wraps when the
                                        line runs out. UniformGridLayout could do neither: left to
                                        content it measured the first chip and gave every cell that
                                        width, clipping the remove button off anything longer;
                                        forced to fill two columns it stretched "Guest" across half
                                        the panel with its × marooned at the far right.
                                    -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.AssignedRoles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <!--
                                                Without this the container stretches and the chip
                                                inside it stretches with it, which is the same
                                                problem in a different place.
                                            -->
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:AssignedRole">
                                                <Border
                                                    Padding="10,3,4,3"
                                                    HorizontalAlignment="Left"
                                                    Background="{x:Bind local:AdminFormat.RoleBackground(Name)}"
                                                    CornerRadius="11">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="{x:Bind local:AdminFormat.RoleForeground(Name)}"
                                                            Text="{x:Bind Name}" />
                                                        <!--
                                                            Bigger, and in the ordinary text
                                                            colour. At 9px in the chip's own hue it
                                                            was drawn — and invisible: a red glyph
                                                            on a red tint, in a box the size of a
                                                            full stop.
                                                        -->
                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Remove this role"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{x:Bind RemoveCommand}"
                                                            CommandParameter="{x:Bind Name}"
                                                            CornerRadius="12"
                                                            ToolTipService.ToolTip="Remove this role"
                                                            Visibility="{x:Bind local:UsersPage.WhenTrue(CanRemove)}">
                                                            <FontIcon
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Glyph="&#xE711;" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="No roles"
                                        Visibility="{x:Bind local:UsersPage.WhenEmpty(ViewModel.AssignedRoles.Count), Mode=OneWay}" />

                                    <!--
                                        Only the roles this person does not already hold. Offering
                                        one they have was the old bug: the server accepted it
                                        idempotently, so the button looked broken.
                                    -->
                                    <Grid ColumnSpacing="6" Visibility="{x:Bind local:UsersPage.WhenAssignable(ViewModel.CanManageRoles, ViewModel.AssignableRoles.Count), Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            Grid.Column="0"
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.AssignableRoles}"
                                            PlaceholderText="Add a role..."
                                            SelectedItem="{x:Bind ViewModel.RoleToAssign, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="services:RoleRow">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                            Grid.Column="1"
                                            Command="{x:Bind ViewModel.AssignRoleCommand}"
                                            Content="Add" />
                                    </Grid>
                                </StackPanel>

                                <!--  The newest sessions, each revocable.  -->
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="{x:Bind local:UsersPage.SessionsHeader(ViewModel.SessionCount), Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:SessionEntry">
                                                <Grid Margin="0,3" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Grid.Column="0"
                                                        Width="28"
                                                        Height="28"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="7">
                                                        <FontIcon
                                                            FontSize="13"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Glyph="&#xE7F8;" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind local:UsersPage.SessionTitle(Session.Device, Session.Client)}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind local:UsersPage.SessionMeta(Session.IpAddress, Session.LastSeenAt)}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Column="2"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="8"
                                                        Visibility="{x:Bind Session.IsCurrent}">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                            Text="This device" />
                                                    </Border>
                                                    <Button
                                                        Grid.Column="3"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="End this session"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{x:Bind RevokeCommand}"
                                                        CommandParameter="{x:Bind Session.Id}"
                                                        ToolTipService.ToolTip="End this session">
                                                        <FontIcon
                                                            FontSize="11"
                                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                            Glyph="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ViewModel.MoreSessions, Mode=OneWay}"
                                        Visibility="{x:Bind local:UsersPage.WhenText(ViewModel.MoreSessions), Mode=OneWay}" />
                                </StackPanel>

                                <!--  Danger zone.  -->
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="DANGER ZONE" />
                                    <Border
                                        Padding="14,8"
                                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" Text="{x:Bind local:UsersPage.DescribeToggleTitle(ViewModel.SelectedUser), Mode=OneWay}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind local:UsersPage.DescribeToggleSub(ViewModel.SelectedUser), Mode=OneWay}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Command="{x:Bind ViewModel.ToggleActiveCommand}"
                                                    Content="{x:Bind local:UsersPage.DescribeToggle(ViewModel.SelectedUser), Mode=OneWay}"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" Text="Delete user" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="Permanently remove · cannot be undone"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Command="{x:Bind ViewModel.DeleteUserCommand}"
                                                    Content="Delete"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!--
                        The close button is a sibling of the ScrollViewer, not a child of it. Inside,
                        the negative margin that pulled it into the hero's corner put it outside the
                        viewport, where the card's rounded Border clipped it — visible, and not
                        hit-testable. Out here it is simply on top.
                    -->
                    <Button
                        Margin="0,8,8,0"
                        Padding="6,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="Close details"
                        Command="{x:Bind ViewModel.CloseDetailCommand}"
                        ToolTipService.ToolTip="Close"
                        Visibility="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <ProgressRing
            Grid.Row="2"
            Width="36"
            Height="36"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <!--
            What a caller without the permission sees. The server refuses every call this page
            makes, so the alternative is a screen of empty lists and a stack of error bars.
        -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Margin="-24,-12,-24,-20"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            Visibility="{x:Bind local:UsersPage.Not(ViewModel.IsPermitted), Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon FontSize="32" Glyph="&#xE72E;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="You do not have access to users" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Ask an administrator for the users manage permission." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
