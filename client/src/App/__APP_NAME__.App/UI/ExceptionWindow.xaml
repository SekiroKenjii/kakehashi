<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="__ROOT_NAMESPACE__.App.UI.ExceptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Title="Unexpected error"
    Width="720"
    Height="520"
    IsMaximizable="False"
    IsMinimizable="False"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon FontSize="28"
                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                      Glyph="&#xEA39;" />
            <TextBlock VerticalAlignment="Center"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Text="Something went wrong" />
        </StackPanel>

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2"
                      Padding="12"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1">
            <TextBlock x:Name="DetailText"
                       FontFamily="Consolas"
                       FontSize="12"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Click="OnRestartButtonClick" Content="Restart" />
            <Button Click="OnCloseButtonClick" Content="Close app" />
            <Button Click="OnContinueButtonClick"
                    Content="Continue"
                    Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</winex:WindowEx>
