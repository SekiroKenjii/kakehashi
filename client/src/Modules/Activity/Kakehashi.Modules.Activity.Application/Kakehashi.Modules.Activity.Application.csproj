<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kakehashi.Modules.Activity.Application</RootNamespace>
    <AssemblyName>Kakehashi.Modules.Activity.Application</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <!-- No Domain project, unlike Notes and Auth. A domain layer exists to hold invariants that must
       hold before something is written, and this module never writes: the feed is read-only, and
       the server is the only thing that appends to it. An empty Domain assembly would be a layer
       added to match a diagram rather than to enforce anything. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Kakehashi.SharedKernel\Kakehashi.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kakehashi.Application.Abstractions\Kakehashi.Application.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kakehashi.Mediator\Kakehashi.Mediator.csproj" />
  </ItemGroup>

</Project>
