<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Kakehashi.Modules.Activity.UI</RootNamespace>
    <AssemblyName>Kakehashi.Modules.Activity.UI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <!-- See Kakehashi.Modules.Auth.UI for why CS0618 is here: the XAML type generator emits a
         reference to a property the Windows App SDK deprecated, in a file nobody writes. -->
    <NoWarn>CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\App\Kakehashi.App.Infrastructure\Kakehashi.App.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kakehashi.Contracts\Kakehashi.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kakehashi.UI.Common\Kakehashi.UI.Common.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kakehashi.UI.Contracts\Kakehashi.UI.Contracts.csproj" />
    <ProjectReference Include="..\Kakehashi.Modules.Activity.Application\Kakehashi.Modules.Activity.Application.csproj" />
  </ItemGroup>

</Project>
