<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Kakehashi.Modules.Activity.UI.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Kakehashi.UI.Common.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Kakehashi.Modules.Activity.UI.ViewModels"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="CaptionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="50" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1240"
            Padding="24"
            HorizontalAlignment="Stretch"
            Spacing="12">

            <!--  Breadcrumb  -->
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE81C;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Activity" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">

                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Recent activity" />
                            <!--  The one sentence that says what this page is FOR: it is the same
                                  feed on every machine, which is the whole point of it living on
                                  the server rather than in local settings.  -->
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Everything that has happened to your account, from every device you use."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.LoadCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <!--  Empty state. Distinct from the error bar above on purpose: "nothing has
                          happened yet" and "we could not ask" look the same to a user unless the
                          page says which it is.  -->
                    <StackPanel
                        Padding="0,24"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                        <FontIcon
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE81C;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Nothing here yet." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Feed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityListItem">
                                <Grid
                                    Padding="0,10"
                                    ColumnSpacing="14"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="32"
                                        Height="32"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="16">
                                        <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                        <!--  Device and address are what answer "was that me?", so
                                              they are the detail line rather than a tooltip.  -->
                                        <TextBlock
                                            FontFamily="Cascadia Mono,Consolas"
                                            Style="{StaticResource CaptionLabelStyle}"
                                            Text="{x:Bind Details}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasDetails}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource CaptionLabelStyle}"
                                        Text="{x:Bind TimeText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
