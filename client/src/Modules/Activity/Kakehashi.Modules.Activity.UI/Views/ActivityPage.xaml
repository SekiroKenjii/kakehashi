<Page
    x:Class="Kakehashi.Modules.Activity.UI.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Kakehashi.UI.Common.Behaviors"
    xmlns:common="using:Kakehashi.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Kakehashi.Modules.Activity.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Kakehashi.Modules.Activity.UI.ViewModels"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MonoTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,12,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PageHeader Grid.Row="0" Title="Activity">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="Export CSV"
                    Command="{x:Bind ViewModel.ExportCommand}"
                    Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Glyph="&#xEDE1;" />
                        <TextBlock VerticalAlignment="Center" Text="Export CSV" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource CommandBarDividerStyle}" />
                <Button
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </common:PageHeader>

        <!--  The four counts. Every number here is one the server counted over the whole range.  -->
        <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.StatCards}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="common:StatCard">
                    <common:StatCardView Card="{x:Bind}" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="4"
                    MinColumnSpacing="12"
                    Orientation="Horizontal" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <!--  Filter bar. Search applies on submit, not per keystroke — the server does the searching.  -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                Grid.Column="0"
                Width="280"
                AutomationProperties.AutomationId="ActivitySearch"
                AutomationProperties.Name="Search activity"
                PlaceholderText="Search events, address, device..."
                QueryIcon="Find"
                QuerySubmitted="OnSearchSubmitted"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ItemsRepeater Grid.Column="1" ItemsSource="{x:Bind ViewModel.Chips}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityChip">
                        <Button
                            Margin="0,0,6,0"
                            Padding="12,5"
                            AutomationProperties.Name="{x:Bind AnnouncedName, Mode=OneWay}"
                            Background="{x:Bind local:ActivityPage.ChipBackground(IsSelected), Mode=OneWay}"
                            Click="OnChipClicked"
                            CornerRadius="14"
                            Tag="{x:Bind}"
                            Foreground="{x:Bind local:ActivityPage.ChipForeground(IsSelected), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock FontSize="12.5" Text="{x:Bind Label}" />
                                <TextBlock
                                    FontSize="12.5"
                                    Opacity="0.7"
                                    Text="{x:Bind CountText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="0" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <ComboBox
                Grid.Column="2"
                MinWidth="150"
                AutomationProperties.Name="Range"
                ItemsSource="{x:Bind ViewModel.Ranges}"
                SelectedItem="{x:Bind ViewModel.SelectedRange, Mode=TwoWay}" />
        </Grid>

        <InfoBar
            Grid.Row="3"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar
                    Grid.Row="0"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                <StackPanel
                    Grid.Row="1"
                    Padding="0,48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE81C;" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Nothing here yet." />
                </StackPanel>

                <!--
                    Grouped by the reader's own days. AreStickyGroupHeadersEnabled is what keeps the
                    day visible while its rows scroll past, which is the whole reason the feed is
                    grouped rather than stamped with a date on every row.
                -->
                <ListView
                    x:Name="FeedList"
                    Grid.Row="1"
                    IsItemClickEnabled="True"
                    ItemClick="OnRowClicked"
                    SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.GroupStyle>
                        <GroupStyle HidesIfEmpty="True">
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="vm:ActivityDay">
                                    <Grid
                                        Padding="16,10"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource SectionLabelStyle}"
                                            Text="{x:Bind Title}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind CountText}" />
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="16,10" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ActivityRow">
                            <StackPanel
                                AutomationProperties.Name="{x:Bind AnnouncedName, Mode=OneWay}"
                                Spacing="8">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        VerticalAlignment="Top"
                                        Background="{x:Bind local:ActivityPage.IconBackground(IsAlert)}"
                                        CornerRadius="9">
                                        <FontIcon
                                            FontSize="15"
                                            Foreground="{x:Bind local:ActivityPage.IconForeground(IsAlert)}"
                                            Glyph="{x:Bind Glyph}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}" />
                                            <Border Style="{StaticResource PillStyle}" Visibility="{x:Bind IsBurst}">
                                                <TextBlock
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Style="{StaticResource MonoTextStyle}"
                                                    Text="{x:Bind CountText}" />
                                            </Border>
                                            <Border
                                                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                                CornerRadius="9"
                                                Padding="8,1"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsNew}">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Text="NEW" />
                                            </Border>
                                            <Border Style="{StaticResource PillStyle}" Visibility="{x:Bind ShowCategory}">
                                                <TextBlock
                                                    FontSize="9.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind CategoryText}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource MonoTextStyle}"
                                            Text="{x:Bind Meta}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasMeta}" />

                                        <HyperlinkButton
                                            Padding="0"
                                            Click="OnSecureClicked"
                                            Content="Wasn't you? Secure your account"
                                            FontSize="11.5"
                                            Visibility="{x:Bind CanSecure}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Top"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind TimeText}" />
                                </Grid>

                                <!--  What the row was collapsed from, and the facts behind it.  -->
                                <StackPanel
                                    Margin="48,0,0,0"
                                    Spacing="8"
                                    Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                                    <ItemsRepeater ItemsSource="{x:Bind Occurrences}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource MonoTextStyle}"
                                                    Text="{x:Bind}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <ItemsRepeater ItemsSource="{x:Bind Facts}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ActivityDetail">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Label}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="11.5"
                                                        Style="{StaticResource MonoTextStyle}"
                                                        Text="{x:Bind Value}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>

                                    <Button
                                        HorizontalAlignment="Left"
                                        Click="OnCopyClicked"
                                        Tag="{x:Bind}">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Glyph="&#xE8C8;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="Copy this event" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid
                    Grid.Row="2"
                    Padding="16,12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Content="Load more"
                        Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.CountSummary, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
