<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="__ROOT_NAMESPACE__.Modules.Notes.UI.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:__ROOT_NAMESPACE__.UI.Common.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:__ROOT_NAMESPACE__.Modules.Notes.UI.ViewModels"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="CaptionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="50" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1240"
            Padding="24"
            HorizontalAlignment="Stretch"
            Spacing="12">

            <!--  Breadcrumb  -->
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="__APP_TITLE__" />
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76C;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Notes" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">

                    <!--  Card header: caption, actions, pager  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionLabelStyle}"
                            Text="NOTES" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="2"
                                Visibility="{x:Bind ViewModel.HasPaging, Mode=OneWay}">
                                <Button
                                    AutomationProperties.Name="Previous page"
                                    Command="{x:Bind ViewModel.PrevPageCommand}"
                                    Style="{StaticResource PagerButtonStyle}"
                                    ToolTipService.ToolTip="Previous page">
                                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                                </Button>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.Name="Next page"
                                    Command="{x:Bind ViewModel.NextPageCommand}"
                                    Style="{StaticResource PagerButtonStyle}"
                                    ToolTipService.ToolTip="Next page">
                                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                                </Button>
                            </StackPanel>

                            <Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="New note"
                                Click="OnNewNote"
                                Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                    <TextBlock Text="New note" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  Empty state  -->
                    <StackPanel
                        Padding="0,20"
                        HorizontalAlignment="Center"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.HasNoNotes, Mode=OneWay}">
                        <FontIcon
                            FontSize="24"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE70B;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="No notes yet." />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Notes}" Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NoteListItem">
                                <Grid Padding="0,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Preview}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasPreview}" />
                                        <TextBlock
                                            FontStyle="Italic"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="Empty note"
                                            Visibility="{x:Bind HasNoPreview}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind TimeText}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="{x:Bind Title}"
                                        AutomationProperties.Name="Edit"
                                        Click="OnEditNote"
                                        Style="{StaticResource PagerButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Edit">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.HelpText="{x:Bind Title}"
                                        AutomationProperties.Name="Delete"
                                        Click="OnDeleteNote"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource PagerButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Delete">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ContentDialog
                x:Name="EditNoteDialog"
                Title="{x:Bind ViewModel.DialogHeader, Mode=OneWay}"
                CloseButtonText="Cancel"
                DefaultButton="Primary"
                PrimaryButtonClick="OnSaveNote"
                PrimaryButtonText="Save">
                <StackPanel MinWidth="420" Spacing="12">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasDialogError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.DialogError, Mode=OneWay}"
                        Severity="Error" />
                    <TextBox
                        Header="Title"
                        PlaceholderText="What is this note about?"
                        Text="{x:Bind ViewModel.EditTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Height="160"
                        AcceptsReturn="True"
                        Header="Body"
                        PlaceholderText="Optional"
                        Text="{x:Bind ViewModel.EditBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ContentDialog>

            <ContentDialog
                x:Name="DeleteNoteDialog"
                Title="Delete note"
                CloseButtonText="Cancel"
                DefaultButton="Close"
                PrimaryButtonClick="OnConfirmDelete"
                PrimaryButtonText="Delete">
                <TextBlock
                    MinWidth="360"
                    Text="{x:Bind ViewModel.DeletePrompt, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </ContentDialog>
        </StackPanel>
    </ScrollViewer>
</Page>
