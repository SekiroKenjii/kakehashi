<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="__ROOT_NAMESPACE__.Modules.Auth.UI.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Title="Sign in to __APP_TITLE__"
    Width="420"
    Height="600"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="False"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid Padding="40,44,40,28">

        <!--  In-app mode: one screen. Errors appear inline so the typed email survives a failure.  -->
        <StackPanel Visibility="{x:Bind ViewModel.ShowsCredentialForm}">
            <ImageIcon
                Height="64"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="Bold"
                Text="Sign in to __APP_TITLE__" />
            <TextBlock
                Margin="0,8,0,24"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Enter your account credentials to continue."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <TextBox
                Header="Email"
                InputScope="EmailSmtpAddress"
                IsEnabled="{x:Bind ViewModel.IsFormEnabled, Mode=OneWay}"
                PlaceholderText="you@example.com"
                Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox
                Margin="0,12,0,0"
                Header="Password"
                IsEnabled="{x:Bind ViewModel.IsFormEnabled, Mode=OneWay}"
                Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Password" />

            <InfoBar
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <Button
                Margin="0,20,0,0"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.SignInCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <Grid>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.IsFormEnabled, Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE77B;" />
                        <TextBlock FontWeight="SemiBold" Text="Sign in" />
                    </StackPanel>
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>
            </Button>

            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <!--
                    Both bound, never literals: the glyph and text derive from the configured
                    authority's scheme, and an unconditional "Sent over TLS" would be false against
                    an http authority.
                -->
                <FontIcon
                    FontSize="13"
                    Foreground="{x:Bind ViewModel.TransportBrush}"
                    Glyph="{x:Bind ViewModel.TransportGlyph}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.TransportSummary}" />
            </StackPanel>

            <Border
                Margin="0,20,0,0"
                Padding="0,16,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Mono,Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.VersionText}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="·" />
                    <HyperlinkButton
                        Padding="0"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.TroubleshootConnectionCommand}"
                        FontSize="11"
                        Content="Check server" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  Browser mode, state 1: initial — explain the flow, offer sign-in  -->
        <StackPanel Visibility="{x:Bind ViewModel.ShowsBrowserPrompt, Mode=OneWay}">
            <ImageIcon
                Height="64"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="Bold"
                Text="Sign in to __APP_TITLE__" />
            <TextBlock
                Margin="0,8,0,24"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Sign in with your organization account to continue."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border
                Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <StackPanel
                        Padding="0,5"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Width="22"
                            Height="22"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="1" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Your" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="default browser" />
                            <Run Text="will open" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel
                        Padding="0,5"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Width="22"
                            Height="22"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="2" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Authenticate with" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="company SSO" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel
                        Padding="0,5"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Width="22"
                            Height="22"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="3" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Return here" />
                            <Run
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="automatically" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button
                Margin="0,24,0,0"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.SignInCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE774;" />
                    <TextBlock FontWeight="SemiBold" Text="Sign in with browser" />
                </StackPanel>
            </Button>

            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE72E;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Secured by OAuth 2.0" />
            </StackPanel>

            <Border
                Margin="0,20,0,0"
                Padding="0,16,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Mono,Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.VersionText}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="·" />
                    <!--
                        A working link, not a label: it opens the authorization server in the
                        system browser so the user can check reachability.
                    -->
                    <HyperlinkButton
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Troubleshoot the connection"
                        Command="{x:Bind ViewModel.TroubleshootConnectionCommand}"
                        Content="Need help?"
                        FontSize="11" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!--  Browser mode, state 2: waiting — browser flow in progress  -->
        <StackPanel Visibility="{x:Bind ViewModel.ShowsBrowserWaiting, Mode=OneWay}">
            <Border
                Width="64"
                Height="64"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <ProgressRing
                    Width="32"
                    Height="32"
                    IsActive="True" />
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="Bold"
                Text="Waiting for sign-in..." />
            <TextBlock
                Margin="0,8,0,20"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Complete the sign-in in your browser. We'll continue automatically once you're done."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border
                Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <StackPanel
                        Padding="0,5"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Width="22"
                            Height="22"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                            <FontIcon
                                FontSize="10"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Text="Browser opened" />
                    </StackPanel>
                    <StackPanel
                        Padding="0,5"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Width="22"
                            Height="22"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                            <ProgressRing
                                Width="12"
                                Height="12"
                                MinWidth="12"
                                MinHeight="12"
                                IsActive="True" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Waiting for authentication..." />
                    </StackPanel>
                    <StackPanel
                        Padding="0,5"
                        Opacity="0.5"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Border
                            Width="22"
                            Height="22"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="3" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Return to app" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button
                Margin="0,20,0,10"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.ReopenBrowserCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                    <TextBlock Text="Reopen browser" />
                </StackPanel>
            </Button>
            <HyperlinkButton
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.SignInCancelCommand}"
                Content="Cancel" />
        </StackPanel>

        <!--  Browser mode, state 3: failed — error detail with retry  -->
        <StackPanel Visibility="{x:Bind ViewModel.ShowsBrowserError, Mode=OneWay}">
            <Border
                Width="64"
                Height="64"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xEA39;" />
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="Bold"
                Text="Sign-in failed" />
            <TextBlock
                Margin="0,8,0,20"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="We couldn't complete the sign-in. Please try again."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Border
                Padding="14,10"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock
                    FontFamily="Cascadia Mono,Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>

            <Button
                Margin="0,20,0,10"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.SignInCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    <TextBlock FontWeight="SemiBold" Text="Try again" />
                </StackPanel>
            </Button>
            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.TroubleshootConnectionCommand}"
                Content="Troubleshoot connection" />

            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE72E;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="If this persists, contact your administrator" />
            </StackPanel>
        </StackPanel>
    </Grid>
</winex:WindowEx>
