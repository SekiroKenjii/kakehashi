<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="__ROOT_NAMESPACE__.Modules.Auth.UI.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:__ROOT_NAMESPACE__.UI.Common.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:__ROOT_NAMESPACE__.Modules.Auth.UI.ViewModels"
    behaviors:NavigationViewHeaderBehavior.HeaderMode="Never"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="CaptionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CharacterSpacing" Value="50" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldValueStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel
            MaxWidth="1240"
            Padding="24"
            HorizontalAlignment="Stretch"
            Spacing="12">

            <!--  Breadcrumb  -->
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="__APP_TITLE__" />
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE76C;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Account" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <!--  Signed-out state  -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="You are not signed in" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Sign in to view your account, active sessions and security activity." />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.SignInCommand}"
                        Content="Sign in"
                        IsEnabled="{x:Bind ViewModel.CanSignIn, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!--  Signed-in state: profile + sessions/activity  -->
            <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="400" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="12">

                    <!--  Profile header  -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture
                                Width="64"
                                Height="64"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                DisplayName="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                                Foreground="{ThemeResource TextOnAccentFillColorDefaultBrush}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="6">
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.Email, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Style="{StaticResource PillStyle}" Visibility="{x:Bind ViewModel.HasRole, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Glyph="&#xE7EF;" />
                                            <TextBlock FontSize="12" Text="{x:Bind ViewModel.RoleText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource PillStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse
                                                Width="7"
                                                Height="7"
                                                VerticalAlignment="Center"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock FontSize="12" Text="Active session" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="OnEditProfileClick"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                        <TextBlock Text="Edit profile" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" Click="OnChangePasswordClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE8D7;" />
                                        <TextBlock Text="Change password" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Account information  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="ACCOUNT INFORMATION" />
                            <Grid ColumnSpacing="16" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Display name" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource FieldValueStyle}"
                                    Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource FieldLabelStyle}"
                                    Text="Email" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontFamily="Cascadia Mono,Consolas"
                                    Style="{StaticResource FieldValueStyle}"
                                    Text="{x:Bind ViewModel.Email, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource FieldLabelStyle}"
                                    Text="Your time zone" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource FieldValueStyle}"
                                    Text="{x:Bind ViewModel.TimeZoneText}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource FieldLabelStyle}"
                                    Text="Auth method" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource FieldValueStyle}"
                                    Text="{x:Bind ViewModel.AuthMethodText}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Session actions  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Style="{StaticResource CaptionLabelStyle}"
                                Text="SESSION ACTIONS" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Sign out from this device" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Your local token will be revoked · unsaved work is kept" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SignOutCommand}"
                                    Content="Sign out"
                                    IsEnabled="{x:Bind ViewModel.CanSignOut, Mode=OneWay}" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Sign out everywhere" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Revoke all sessions on all devices · requires re-authentication" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ViewModel.SignOutEverywhereCommand}"
                                    Content="Sign out all devices"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    IsEnabled="{x:Bind ViewModel.CanSignOut, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">

                    <!--  Active sessions  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionLabelStyle}"
                                    Text="{x:Bind ViewModel.SessionsHeader, Mode=OneWay}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    Visibility="{x:Bind ViewModel.HasSessionsPaging, Mode=OneWay}">
                                    <Button
                                        AutomationProperties.Name="Previous page of sessions"
                                        Command="{x:Bind ViewModel.SessionsPrevPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanPageSessionsBack, Mode=OneWay}"
                                        Style="{StaticResource PagerButtonStyle}"
                                        ToolTipService.ToolTip="Previous page of sessions">
                                        <FontIcon FontSize="11" Glyph="&#xE76B;" />
                                    </Button>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ViewModel.SessionsPageLabel, Mode=OneWay}" />
                                    <Button
                                        AutomationProperties.Name="Next page of sessions"
                                        Command="{x:Bind ViewModel.SessionsNextPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanPageSessionsForward, Mode=OneWay}"
                                        Style="{StaticResource PagerButtonStyle}"
                                        ToolTipService.ToolTip="Next page of sessions">
                                        <FontIcon FontSize="11" Glyph="&#xE76C;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionItem">
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="36"
                                                Height="36"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <FontIcon FontSize="16" Glyph="&#xE7F4;" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono,Consolas"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="2"
                                                Padding="9,3"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="10"
                                                Visibility="{x:Bind IsCurrent}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Text="This device" />
                                            </Border>
                                            <Button
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Click="OnRevokeSessionClick"
                                                Content="Revoke"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind IsNotCurrent}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--  Security activity  -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionLabelStyle}"
                                    Text="SECURITY ACTIVITY" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    Visibility="{x:Bind ViewModel.HasActivityPaging, Mode=OneWay}">
                                    <Button
                                        AutomationProperties.Name="Previous page of activity"
                                        Command="{x:Bind ViewModel.ActivityPrevPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanPageActivityBack, Mode=OneWay}"
                                        Style="{StaticResource PagerButtonStyle}"
                                        ToolTipService.ToolTip="Previous page of activity">
                                        <FontIcon FontSize="11" Glyph="&#xE76B;" />
                                    </Button>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind ViewModel.ActivityPageLabel, Mode=OneWay}" />
                                    <Button
                                        AutomationProperties.Name="Next page of activity"
                                        Command="{x:Bind ViewModel.ActivityNextPageCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanPageActivityForward, Mode=OneWay}"
                                        Style="{StaticResource PagerButtonStyle}"
                                        ToolTipService.ToolTip="Next page of activity">
                                        <FontIcon FontSize="11" Glyph="&#xE76C;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActivityItem">
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="32"
                                                Height="32"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8">
                                                <Grid>
                                                    <FontIcon
                                                        FontSize="14"
                                                        Glyph="{x:Bind Glyph}"
                                                        Visibility="{x:Bind IsNotAlert}" />
                                                    <FontIcon
                                                        FontSize="14"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        Glyph="{x:Bind Glyph}"
                                                        Visibility="{x:Bind IsAlert}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono,Consolas"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Top"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind TimeText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ContentDialog
                x:Name="EditProfileDialog"
                Title="Edit profile"
                CloseButtonText="Cancel"
                DefaultButton="Primary"
                PrimaryButtonClick="OnEditProfileSave"
                PrimaryButtonText="Save">
                <StackPanel MinWidth="360" Spacing="12">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasDialogError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.DialogError, Mode=OneWay}"
                        Severity="Error" />
                    <TextBox Header="Display name" Text="{x:Bind ViewModel.EditDisplayName, Mode=TwoWay}" />
                    <TextBox Header="Phone (optional)" Text="{x:Bind ViewModel.EditPhone, Mode=TwoWay}" />
                </StackPanel>
            </ContentDialog>

            <ContentDialog
                x:Name="ChangePasswordDialog"
                Title="Change password"
                CloseButtonText="Cancel"
                DefaultButton="Primary"
                PrimaryButtonClick="OnChangePasswordSave"
                PrimaryButtonText="Change password">
                <StackPanel MinWidth="360" Spacing="12">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasDialogError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.DialogError, Mode=OneWay}"
                        Severity="Error" />
                    <PasswordBox Header="Current password" Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay}" />
                    <PasswordBox Header="New password" Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay}" />
                    <PasswordBox Header="Confirm new password" Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}" />
                </StackPanel>
            </ContentDialog>
        </StackPanel>
    </ScrollViewer>
</Page>
