<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Kakehashi.Modules.Auth.UI</RootNamespace>
    <AssemblyName>Kakehashi.Modules.Auth.UI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <!-- Obsolete-API warnings, suppressed because the offender is generated code. The XAML type
         generator enumerates every property of every type reachable from the markup, including
         Window.Icon, which the Windows App SDK deprecated in 2.3. Nothing here uses it, and there
         is no way to tell the generator to leave it out. The cost of the blanket suppression is
         that a genuinely obsolete call in this project would also go unreported. -->
    <NoWarn>CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Kakehashi.UI.Common\Kakehashi.UI.Common.csproj" />
    <ProjectReference Include="..\..\..\Shared\Kakehashi.UI.Contracts\Kakehashi.UI.Contracts.csproj" />
    <ProjectReference Include="..\Kakehashi.Modules.Auth.Application\Kakehashi.Modules.Auth.Application.csproj" />
  </ItemGroup>

</Project>
